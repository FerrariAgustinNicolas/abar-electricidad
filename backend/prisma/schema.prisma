generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(100)
  email               String   @unique(map: "AdminUser_email_key") @db.VarChar(254)
  passwordHash        String   @db.VarChar(256)
  active              Boolean  @default(true)
  mustChangePassword  Boolean  @default(true)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  sessions            AuthSession[]
  stockOperations     StockOperation[]
}

model AuthSession {
  id                    String    @id @db.Char(64)
  adminUserId           String    @db.Uuid
  nonceCiphertext       Bytes
  nonceIv               Bytes     @db.ByteA
  nonceTag              Bytes     @db.ByteA
  nonceVersion          Int       @default(1)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  lastActivityAt        DateTime  @db.Timestamptz(3)
  absoluteExpiresAt      DateTime  @db.Timestamptz(3)
  idleExpiresAt          DateTime  @db.Timestamptz(3)
  revokedAt              DateTime? @db.Timestamptz(3)
  adminUser              AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model AdminUserAudit {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAdminUserId   String   @db.Uuid
  targetAdminUserId  String   @db.Uuid
  action             String   @db.VarChar(32)
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetAdminUserId, createdAt])
  @@index([actorAdminUserId, createdAt])
}

model AuthPreAuthContext {
  id               String   @id @db.Char(64)
  nonceCiphertext  Bytes
  nonceIv          Bytes    @db.ByteA
  nonceTag         Bytes    @db.ByteA
  nonceVersion     Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// H2 catalog: no orders, reservations, payments, variants or counter synchronization.
enum PresentationUnit {
  UNIT
  METER
  ROLL
}

enum StockOperationType {
  ADJUSTMENT
  ROLL_OPENING
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String    @default("") @db.VarChar(1000)
  active      Boolean   @default(true)
  order       Int       @default(0)
  version     Int       @default(1)
  products    Product[]

  @@index([active, order])
}

model Product {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String                @db.Uuid
  name             String                @db.VarChar(200)
  slug             String                @unique @db.VarChar(120)
  brand            String?               @db.VarChar(100)
  sku              String?               @unique @db.VarChar(100)
  shortDescription String                @default("") @db.VarChar(500)
  description      String                @default("") @db.VarChar(10000)
  attributes       Json                  @default("[]") @db.JsonB
  active           Boolean               @default(true)
  featured         Boolean               @default(false)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  presentations    ProductPresentation[]
  images           ProductImage[]

  @@index([categoryId, active])
  @@index([active, featured])
  @@index([name, id])
}

model ProductPresentation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String           @db.Uuid
  unit              PresentationUnit
  rollLengthMeters  Int?
  amountMinor       BigInt
  lowStockThreshold Int              @default(0)
  active            Boolean          @default(true)
  isDefault         Boolean          @default(false)
  version           Int              @default(1)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  balance           StockBalance?
  entries           StockEntry[]

  @@unique([productId, unit])
  @@index([active, unit, amountMinor])
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @db.Uuid
  storageKey  String   @unique @db.VarChar(80)
  contentType String   @db.VarChar(40)
  bytes       Int
  width       Int
  height      Int
  alt         String   @db.VarChar(200)
  order       Int      @default(0)
  isPrimary   Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, order])
}

model StockBalance {
  presentationId    String              @id @db.Uuid
  availableQuantity Int                 @default(0)
  version           Int                 @default(1)
  presentation      ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)
}

model StockOperation {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             StockOperationType
  reason           String             @db.VarChar(500)
  actorAdminUserId String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  idempotencyKey   String             @db.VarChar(200)
  requestHash      String             @db.Char(64)
  metadata         Json               @default("{}") @db.JsonB
  result           Json               @default("{}") @db.JsonB
  actor            AdminUser          @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)
  entries          StockEntry[]

  @@unique([actorAdminUserId, idempotencyKey])
  @@index([createdAt, id])
  @@index([actorAdminUserId, createdAt])
}

model StockEntry {
  operationId      String              @db.Uuid
  presentationId   String              @db.Uuid
  delta            Int
  resultingQuantity Int
  version          Int
  operation        StockOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict)
  presentation     ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@id([operationId, presentationId])
  @@index([presentationId, operationId])
}

// Backend-owned demo policy. H6 may add administration without rewriting quote snapshots.
model CheckoutPolicy {
  id                    String   @id @db.VarChar(32)
  feeMinor              BigInt   @default(0)
  quoteTtlSeconds       Int      @default(600)
  enabledDeliveryModes  Json     @db.JsonB
  paymentMethods        Json     @db.JsonB
  version               Int      @default(1)
  updatedAt             DateTime @default(now()) @db.Timestamptz(3)
}

model CheckoutQuote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersion   Int
  stateFingerprint String  @db.Char(64)
  response        Json     @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}
