generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                String   @db.VarChar(100)
  email               String   @unique(map: "AdminUser_email_key") @db.VarChar(254)
  passwordHash        String   @db.VarChar(256)
  active              Boolean  @default(true)
  mustChangePassword  Boolean  @default(true)
  version             Int      @default(1)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  sessions            AuthSession[]
  stockOperations     StockOperation[]
}

model AuthSession {
  id                    String    @id @db.Char(64)
  adminUserId           String    @db.Uuid
  nonceCiphertext       Bytes
  nonceIv               Bytes     @db.ByteA
  nonceTag              Bytes     @db.ByteA
  nonceVersion          Int       @default(1)
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  lastActivityAt        DateTime  @db.Timestamptz(3)
  absoluteExpiresAt      DateTime  @db.Timestamptz(3)
  idleExpiresAt          DateTime  @db.Timestamptz(3)
  revokedAt              DateTime? @db.Timestamptz(3)
  adminUser              AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@index([absoluteExpiresAt])
  @@index([idleExpiresAt])
}

model AdminUserAudit {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAdminUserId   String   @db.Uuid
  targetAdminUserId  String   @db.Uuid
  action             String   @db.VarChar(32)
  reason             String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)

  @@index([targetAdminUserId, createdAt])
  @@index([actorAdminUserId, createdAt])
}

model AuthPreAuthContext {
  id               String   @id @db.Char(64)
  nonceCiphertext  Bytes
  nonceIv          Bytes    @db.ByteA
  nonceTag         Bytes    @db.ByteA
  nonceVersion     Int      @default(1)
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime @db.Timestamptz(3)

  @@index([expiresAt])
}

// H2 catalog: no orders, reservations, payments, variants or counter synchronization.
enum PresentationUnit {
  UNIT
  METER
  ROLL
}

enum StockOperationType {
  ADJUSTMENT
  ROLL_OPENING
}

model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String    @default("") @db.VarChar(1000)
  active      Boolean   @default(true)
  order       Int       @default(0)
  version     Int       @default(1)
  products    Product[]

  @@index([active, order])
}

model Product {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId       String                @db.Uuid
  name             String                @db.VarChar(200)
  slug             String                @unique @db.VarChar(120)
  brand            String?               @db.VarChar(100)
  sku              String?               @unique @db.VarChar(100)
  shortDescription String                @default("") @db.VarChar(500)
  description      String                @default("") @db.VarChar(10000)
  attributes       Json                  @default("[]") @db.JsonB
  active           Boolean               @default(true)
  featured         Boolean               @default(false)
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  category         Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  presentations    ProductPresentation[]
  images           ProductImage[]

  @@index([categoryId, active])
  @@index([active, featured])
  @@index([name, id])
}

model ProductPresentation {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId         String           @db.Uuid
  unit              PresentationUnit
  rollLengthMeters  Int?
  amountMinor       BigInt
  lowStockThreshold Int              @default(0)
  active            Boolean          @default(true)
  isDefault         Boolean          @default(false)
  version           Int              @default(1)
  product           Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  balance           StockBalance?
  entries           StockEntry[]
  orderItems        OrderItem[]

  @@unique([productId, unit])
  @@index([active, unit, amountMinor])
}

model ProductImage {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String   @db.Uuid
  storageKey  String   @unique @db.VarChar(80)
  contentType String   @db.VarChar(40)
  bytes       Int
  width       Int
  height      Int
  alt         String   @db.VarChar(200)
  order       Int      @default(0)
  isPrimary   Boolean  @default(false)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([productId, order])
}

model StockBalance {
  presentationId    String              @id @db.Uuid
  availableQuantity Int                 @default(0)
  version           Int                 @default(1)
  presentation      ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)
}

model StockOperation {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             StockOperationType
  reason           String             @db.VarChar(500)
  actorAdminUserId String             @db.Uuid
  createdAt        DateTime           @default(now()) @db.Timestamptz(3)
  idempotencyKey   String             @db.VarChar(200)
  requestHash      String             @db.Char(64)
  metadata         Json               @default("{}") @db.JsonB
  result           Json               @default("{}") @db.JsonB
  actor            AdminUser          @relation(fields: [actorAdminUserId], references: [id], onDelete: Restrict)
  entries          StockEntry[]

  @@unique([actorAdminUserId, idempotencyKey])
  @@index([createdAt, id])
  @@index([actorAdminUserId, createdAt])
}

model StockEntry {
  operationId      String              @db.Uuid
  presentationId   String              @db.Uuid
  delta            Int
  resultingQuantity Int
  version          Int
  operation        StockOperation      @relation(fields: [operationId], references: [id], onDelete: Restrict)
  presentation     ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@id([operationId, presentationId])
  @@index([presentationId, operationId])
}

// Backend-owned demo policy. H6 may add administration without rewriting quote snapshots.
model CheckoutPolicy {
  id                    String   @id @db.VarChar(32)
  feeMinor              BigInt   @default(0)
  quoteTtlSeconds       Int      @default(600)
  enabledDeliveryModes  Json     @db.JsonB
  paymentMethods        Json     @db.JsonB
  version               Int      @default(1)
  updatedAt             DateTime @default(now()) @db.Timestamptz(3)
}

model CheckoutQuote {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  policyVersion   Int
  stateFingerprint String  @db.Char(64)
  response        Json     @db.JsonB
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  expiresAt       DateTime @db.Timestamptz(3)
  orders          Order[]

  @@index([expiresAt])
}

enum H4OrderStatus {
  RECEIVED
}
enum H4PaymentStatus {
  PENDING
  REJECTED
}
enum H4AttemptStatus {
  APPROVED
  PENDING
  REJECTED
}
enum H4PaymentMethod {
  DEMO_PAY_ON_PICKUP
  DEMO_TRANSFER
  DEMO_SIMULATION
}
enum H4IdempotencyKind {
  CREATE_ORDER
  PAYMENT_ATTEMPT
}
enum H4NotificationKind {
  ORDER_CREATED_BUYER
  ORDER_CREATED_ADMIN
}
enum H4NotificationState {
  PENDING
}

model Order {
  id                    String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber           String          @unique(map: "Order_orderNumber_key") @db.VarChar(64)
  quoteId               String          @unique(map: "Order_quoteId_key") @db.Uuid
  quote                 CheckoutQuote   @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  status                H4OrderStatus   @default(RECEIVED)
  version               Int             @default(1)
  deliveryMode          String          @db.VarChar(16)
  customerFirstName     String          @db.VarChar(100)
  customerLastName      String          @db.VarChar(100)
  customerEmail         String          @db.VarChar(254)
  customerPhone         String          @db.VarChar(32)
  customerNote          String?         @db.VarChar(500)
  deliveryAddressLine   String?         @db.VarChar(200)
  deliveryLocality      String?         @db.VarChar(100)
  deliveryInstructions  String?         @db.VarChar(500)
  acceptedTermsVersion  String          @db.VarChar(64)
  subtotalMinor         BigInt
  deliveryFeeMinor      BigInt
  totalMinor            BigInt
  accessTokenHash       String          @unique(map: "Order_accessTokenHash_key") @db.Char(64)
  accessExpiresAt       DateTime        @db.Timestamptz(3)
  payment               Payment?
  items                 OrderItem[]
  events                OrderEvent[]
  idempotencyKeys       OrderIdempotencyKey[]
  notifications         NotificationJob[]

  @@index([createdAt, id])
  @@index([customerEmail])
}

model OrderItem {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId            String   @db.Uuid
  presentationId     String   @db.Uuid
  productId          String   @db.Uuid
  productSlug        String   @db.VarChar(120)
  productName        String   @db.VarChar(200)
  unit               String   @db.VarChar(8)
  rollLengthMeters   Int?
  quantity           Int
  unitPriceMinor     BigInt
  lineTotalMinor     BigInt
  snapshot           Json     @db.JsonB
  order              Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  presentation       ProductPresentation @relation(fields: [presentationId], references: [id], onDelete: Restrict)

  @@index([presentationId, orderId])
  @@index([orderId])
}

model Payment {
  id                String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String           @unique(map: "Payment_orderId_key") @db.Uuid
  status            H4PaymentStatus  @default(PENDING)
  amountMinor       BigInt
  currentAttemptId  String?          @unique(map: "Payment_currentAttemptId_key") @db.Uuid
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts          PaymentAttempt[] @relation("PaymentAttempts")
  currentAttempt    PaymentAttempt?  @relation("CurrentPaymentAttempt", fields: [currentAttemptId], references: [id], onDelete: Restrict)

  @@index([status])
}

model PaymentAttempt {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId    String            @db.Uuid
  methodCode   H4PaymentMethod
  status       H4AttemptStatus
  sequence     Int
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @default(now()) @db.Timestamptz(3)
  demoScenario H4AttemptStatus?
  payment      Payment           @relation("PaymentAttempts", fields: [paymentId], references: [id], onDelete: Restrict)
  currentFor   Payment?          @relation("CurrentPaymentAttempt")
  events       OrderEvent[]
  idempotencyKeys OrderIdempotencyKey[]

  @@unique([paymentId, sequence], map: "PaymentAttempt_paymentId_sequence_key")
  @@index([paymentId, createdAt])
}

model OrderEvent {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String         @db.Uuid
  attemptId   String?        @db.Uuid
  eventType   String         @db.VarChar(48)
  createdAt   DateTime       @default(now()) @db.Timestamptz(3)
  details     Json           @default("{}") @db.JsonB
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempt     PaymentAttempt? @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt, id])
}

model OrderIdempotencyKey {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  kind             H4IdempotencyKind
  scope            String           @db.VarChar(64)
  key              String           @db.VarChar(200)
  fingerprint      String           @db.Char(64)
  responseStatus   Int
  responseCiphertext Bytes          @db.ByteA
  responseIv       Bytes            @db.ByteA
  responseTag      Bytes            @db.ByteA
  createdAt        DateTime         @default(now()) @db.Timestamptz(3)
  orderId          String?          @db.Uuid
  attemptId        String?          @db.Uuid
  order            Order?           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempt          PaymentAttempt?  @relation(fields: [attemptId], references: [id], onDelete: Restrict)

  @@unique([scope, key], map: "OrderIdempotencyKey_scope_key_key")
  @@index([orderId])
}

model NotificationJob {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String              @db.Uuid
  kind        H4NotificationKind
  recipient   String              @db.VarChar(254)
  dedupeKey   String              @unique(map: "NotificationJob_dedupeKey_key") @db.VarChar(200)
  state       H4NotificationState @default(PENDING)
  createdAt   DateTime            @default(now()) @db.Timestamptz(3)
  payload     Json                @db.JsonB
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([state, createdAt])
}
